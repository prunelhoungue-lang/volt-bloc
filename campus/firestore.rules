rules_version = '2';
// Règles de sécurité Firestore pour Campus Services.
// À coller dans la console Firebase : Firestore > Rules > Publish.
service cloud.firestore {
  match /databases/{database}/documents {
    match /annonces/{id} {
      // Tout le monde peut lire les annonces.
      allow read: if true;

      // Publier : utilisateur connecté (anonyme), champs valides, propriétaire = soi-même.
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['cat','title','desc','price','place','name','phone','uid','t'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.cat in ['fiches','jobs','cours','print','fourn','divers']
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 80
        && request.resource.data.desc is string && request.resource.data.desc.size() <= 600
        && request.resource.data.price is int
        && request.resource.data.price >= 0 && request.resource.data.price <= 100000000
        && request.resource.data.place is string && request.resource.data.place.size() <= 40
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 30
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9]{8,15}$')
        && request.resource.data.t == request.time;

      // Supprimer : seulement l'auteur de l'annonce.
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;

      // Pas de modification (on supprime et on republie).
      allow update: if false;
    }
  }
}
